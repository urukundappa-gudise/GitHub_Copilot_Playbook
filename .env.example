POSTGRES_DB=aimplify
POSTGRES_USER=aimplify
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://aimplify:change-me@localhost:5432/aimplify
APP_ENV=local
LOG_LEVEL=INFO
