ALLOWED_ORIGINS=http://localhost:5174

AZURE_AD_TENANT_ID=your-entra-tenant-id
AZURE_AD_CLIENT_ID=your-entra-application-client-id
AZURE_AD_CLIENT_SECRET=replace-locally
